critical-alert-player = {$player} ({$character}, {$roles})
critical-alert-hidden-antag = antag

critical-alert-aghost = {$who} aghosted
critical-alert-aghost-other = {$who} was aghosted by {$actor}

critical-alert-spawned = {$who} spawned {$items}
critical-alert-spawned-more = +{$count} more

critical-alert-vv = {$who} used VV: {$changes} (see admin logs)
critical-alert-vv-edit = {$count} {$count ->
    [one] edit
   *[other] edits
}
critical-alert-vv-invoke = {$count} {$count ->
    [one] invoke
   *[other] invokes
}
critical-alert-vv-added = {$count} {$count ->
    [one] comp
   *[other] comps
} added
critical-alert-vv-removed = {$count} {$count ->
    [one] comp
   *[other] comps
} removed

critical-alert-query = {$who} ran antag-data console queries: {$changes} (see admin logs)
critical-alert-query-query = {$count}x
