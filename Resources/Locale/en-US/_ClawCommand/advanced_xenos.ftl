## Claw Command - advanced xenomorph gamemode. Lines follow the original DM source.

## Names
adv-xeno-larva-name = alien larva ({$number})
adv-xeno-caste-name = alien {$caste} ({$number})
adv-xeno-death-message = {CAPITALIZE(THE($xeno))} lets out a waning guttural screech, green blood bubbling from its maw.
adv-xeno-larva-grown = You are growing into a beautiful alien! It is time to choose a caste. Use one of your Evolve actions: hunters are strong and agile, sentinels guard the hive up close and at range, and drones build it and may one day become its queen.
adv-xeno-regen-soothing = You feel a soothing sensation come over you...

## Plasma
adv-xeno-no-vessel = Your plasma vessel has been removed!
adv-xeno-not-enough-plasma = You don't have enough plasma stored to do that.
adv-xeno-need-foundation = You need a solid foundation to do that on.
adv-xeno-too-far = That is too far away.
adv-xeno-cannot-now = You cannot do that in your current state.
adv-xeno-no-guns = Your claws can't work the trigger.
alerts-adv-xeno-plasma-name = Plasma
alerts-adv-xeno-plasma-desc = Plasma stored in your plasma vessel. It refills slowly, faster on weeds or in plasma gas.
alerts-adv-xeno-growth-name = Growth
alerts-adv-xeno-growth-desc = How far along you are. At 200 you can evolve. Weeds and plasma make you grow faster.

## Weeds, resin, eggs
adv-xeno-weeds-planted = {CAPITALIZE(THE($user))} has planted some alien weeds!
adv-xeno-weeds-planted-self = You plant some alien weeds.
adv-xeno-weeds-already = There is already a node here.
adv-xeno-resin-shape = {CAPITALIZE(THE($user))} vomits up a thick purple substance and begins to shape it!
adv-xeno-resin-shape-self = You shape a {$shape}.
adv-xeno-resin-blocked = Something is in the way.
adv-xeno-resin-wall = resin wall
adv-xeno-resin-membrane = resin membrane
adv-xeno-resin-door = resin door
adv-xeno-resin-nest = resin nest
adv-xeno-resin-blob = resin blob
adv-xeno-resin-melt = {CAPITALIZE(THE($user))} strokes the {$resin}, and it melts away!
adv-xeno-egg-already = There's already an egg here.
adv-xeno-egg-laid = {CAPITALIZE(THE($user))} has laid an egg!
adv-xeno-egg-clear = You clear the hatched egg.
adv-xeno-egg-growing = The child is not developed yet.
adv-xeno-egg-retrieve = You retrieve the child.

## Acid
adv-xeno-acid-cannot = You cannot dissolve this object.
adv-xeno-acid-too-far = {CAPITALIZE(THE($target))} is too far away.
adv-xeno-acid-applied = {CAPITALIZE(THE($user))} vomits globs of vile stuff all over {THE($target)}. It begins to sizzle and melt under the bubbling mess of acid!
adv-xeno-acid-holding = {CAPITALIZE(THE($target))} is holding up against the acid!
adv-xeno-acid-melting = {CAPITALIZE(THE($target))}'s structure is being melted by the acid!
adv-xeno-acid-struggling = {CAPITALIZE(THE($target))} is struggling to withstand the acid!
adv-xeno-acid-crumbling = {CAPITALIZE(THE($target))} begins to crumble under the acid!
adv-xeno-acid-collapse = {CAPITALIZE(THE($target))} collapses under its own weight into a puddle of goop and undigested debris!

## Spit
adv-xeno-spit = {CAPITALIZE(THE($user))} spits {$spit}!
adv-xeno-spit-self = You spit {$spit}.
adv-xeno-spit-cannot = You cannot spit in your current state.
adv-xeno-spit-neurotoxin = neurotoxin
adv-xeno-spit-acid = acid

## Plasma transfer
adv-xeno-transfer-no-vessel = Their plasma vessel is missing.
adv-xeno-transfer-closer = You need to be closer.
adv-xeno-transfer-title = Transfer Plasma to {THE($target)}
adv-xeno-transfer-prompt = Amount:
adv-xeno-transfer-received = {CAPITALIZE(THE($user))} has transferred {$amount} plasma to you.
adv-xeno-transfer-sent = You have transferred {$amount} plasma to {THE($target)}.

## Evolution
adv-xeno-evolve = {CAPITALIZE(THE($user))} begins to twist and contort!
adv-xeno-evolve-self = You begin to evolve!
adv-xeno-evolve-cuffed = You cannot evolve when you are cuffed.
adv-xeno-evolve-not-grown = You are not fully grown.
adv-xeno-evolve-queen-exists = We already have an active queen.

## Hunter / sentinel
adv-xeno-leap-cannot = You cannot leap in your current state.
adv-xeno-leap = {CAPITALIZE(THE($user))} leaps at {THE($target)}!
adv-xeno-leap-miss = You miss!
adv-xeno-leap-hands-full = You need to have one hand free to grab someone.
adv-xeno-leap-seize = {CAPITALIZE(THE($user))} seizes {THE($target)} aggressively!
adv-xeno-gut-no-grab = You are not grabbing anyone.
adv-xeno-gut-weak-grab = You must have an aggressive grab to gut your prey!
adv-xeno-gut = {CAPITALIZE(THE($user))} rips viciously at {THE($target)}'s body with its claws!
adv-xeno-tackle-cannot = You cannot tackle someone in your current state.
adv-xeno-tackle = {CAPITALIZE(THE($user))} has tackled down {THE($target)}!
adv-xeno-tackle-fail = {CAPITALIZE(THE($user))} tried to tackle down {THE($target)}!
adv-xeno-whisper-title = Psychic Whisper
adv-xeno-whisper-prompt = Whisper silently to {THE($target)}:
adv-xeno-whisper-heard = You hear a strange, alien voice in your head... [italic]{$message}[/italic]
adv-xeno-whisper-said = You said: "{$message}" to {THE($target)}

## Devour
adv-xeno-devour-need-grab = You need to hold them in an aggressive grab to devour them.
adv-xeno-devour-start = {CAPITALIZE(THE($user))} is attempting to devour {THE($target)}!
adv-xeno-devoured = {CAPITALIZE(THE($user))} devours {THE($target)}!
adv-xeno-regurgitate = {CAPITALIZE(THE($user))} hurls out the contents of their stomach!

## Hide
adv-xeno-hide-on = You are now hiding.
adv-xeno-hide-off = You have stopped hiding.

## Nest
adv-xeno-nest-cannot = You can't secure them in that.
adv-xeno-nest-secured = Something secretes a thick vile goo, securing {THE($victim)} into {THE($nest)}!
adv-xeno-nest-secured-self = You are drenched in a foul-smelling resin, trapped in {THE($nest)}!
adv-xeno-nest-struggle = {CAPITALIZE(THE($victim))} struggles to break free of the gelatinous resin...
adv-xeno-nest-struggle-self = You struggle to break free from the gelatinous resin...
adv-xeno-nest-fail = You fail to break out of the nest.
adv-xeno-nest-free = {CAPITALIZE(THE($victim))} is pulled free of {THE($nest)}.

## Facehugger
adv-xeno-hugger-leaps = {CAPITALIZE(THE($hugger))} leaps at {THE($target)}'s face!
adv-xeno-hugger-helmet = {CAPITALIZE(THE($hugger))} smashes against {THE($target)}'s {$helmet}, but bounces off!
adv-xeno-hugger-bounce = {CAPITALIZE(THE($hugger))} crashes into {THE($target)}'s face, but bounces off!
adv-xeno-hugger-tears-mask = {CAPITALIZE(THE($hugger))} tears {$mask} off of {THE($target)}'s face!
adv-xeno-hugger-synthetic = {CAPITALIZE(THE($hugger))} probes {THE($target)}, finds no suitable host and loses interest.
adv-xeno-hugger-impregnates = {CAPITALIZE(THE($hugger))} falls limp after violating {THE($target)}'s face!
adv-xeno-hugger-sterile = {CAPITALIZE(THE($hugger))} violates {THE($target)}'s face!
adv-xeno-hugger-dies = {CAPITALIZE(THE($hugger))} dies!
adv-xeno-hugger-skitters = {CAPITALIZE(THE($hugger))} skitters.
adv-xeno-hugger-skitters-away = {CAPITALIZE(THE($hugger))} skitters away.
adv-xeno-hugger-skitters-around = {CAPITALIZE(THE($hugger))} skitters around.

## Embryo
adv-xeno-embryo-throat = Your throat feels sore.
adv-xeno-embryo-mucous = Mucous runs down the back of your throat.
adv-xeno-embryo-muscles = Your muscles ache.
adv-xeno-embryo-stomach = Your stomach hurts.
adv-xeno-embryo-tearing = You feel something tearing its way out of your stomach...
adv-xeno-surgery-verb = Explore chest cavity
adv-xeno-surgery-verb-desc = Open the patient's chest and feel around for anything that should not be there.
adv-xeno-surgery-start = {CAPITALIZE(THE($user))} starts cutting into {THE($target)}'s chest!
adv-xeno-surgery-success = {CAPITALIZE(THE($user))} pulls a writhing alien embryo out of {THE($target)}'s chest!
adv-xeno-surgery-nothing = You find nothing unusual.

