## Christmas cracker jokes

cracker-joke-1 = awful joke
    .desc = A tiny folded slip of paper.
    .content = What did one snowman say to the other?

    {""}[italic]"Is it me, or can you smell carrots?"[/italic]
cracker-joke-2 = terrible joke
    .desc = {cracker-joke-1.desc}
    .content = Where are Santa's helpers educated?

    {""}[italic]Nowhere, they're ELF-taught.[/italic]
cracker-joke-3 = unfunny joke
    .desc = {cracker-joke-1.desc}
    .content = What happened to the man who stole advent calendars?

    {""}[italic]He got 25 days.[/italic]
cracker-joke-4 = awful joke
