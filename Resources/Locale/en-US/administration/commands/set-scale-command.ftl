cmd-setscale-desc = Sets the sprite scale of a player's currently controlled entity.
cmd-setscale-help = Usage: setscale <username> <scale>
cmd-setscale-arg-user = <username>
cmd-setscale-arg-scale = <scale>
cmd-setscale-no-entity = That player has no controlled entity right now.
cmd-setscale-invalid-scale = Scale must be a positive number.
